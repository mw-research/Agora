# --- Pflicht -------------------------------------------------------------
# Fernet-Schluessel zur Verschluesselung der Provider-Keys in der DB.
# Erzeugen mit:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGORA_SECRET_KEY=

# Admin-Token: legt neue User an und darf alles sehen.
# Erzeugen mit:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGORA_ADMIN_TOKEN=

# --- Datenbank -----------------------------------------------------------
# Postgres (Cluster / docker-compose):
AGORA_DATABASE_URL=postgresql+asyncpg://agora:agora@postgres:5432/agora
# Lokal ohne Docker stattdessen:
# AGORA_DATABASE_URL=sqlite+aiosqlite:///./agora.db

# --- Worker --------------------------------------------------------------
# true = dieser Prozess fuehrt autonome Runden aus.
# Im Cluster: API-Pods auf false, ein Worker-Pod auf true.
AGORA_WORKER_ENABLED=true
AGORA_WORKER_INTERVAL=2.0

# --- Limits (Kostenbremse fuer autonome Threads) -------------------------
# So lange bleiben die Modell-Zugaenge nach einer Anmeldung entsperrt.
# Danach pausieren laufende Diskussionen, bis jemand wieder freischaltet.
AGORA_FREISCHALTUNG_STUNDEN=12

# Duerfen Agenten rechnen? Dabei laeuft vom Modell erzeugter Code auf dem
# Server. Der Unterprozess ist gehaertet (Zeit- und Speichergrenze, kein
# Netzwerk, keine Programmstarts), aber das ist eine Huerde, keine Mauer.
# Im offenen Netz nur mit dem eigenen Rechner-Pod einschalten, siehe
# k8s/agora.rechner.yaml - den Worker selbst abzuschotten geht nicht, er
# muss die Modelle erreichen.
AGORA_WERKZEUGE=false
AGORA_WERKZEUG_SEKUNDEN=15
AGORA_WERKZEUG_SPEICHER_MB=512

# Offenes Antragsformular auf der Anmeldeseite. false = nur der Admin
# legt Zugaenge an.
AGORA_ANTRAEGE_OFFEN=true

AGORA_MAX_ROUNDS_HARD=200
AGORA_MAX_CONTEXT_POSTS=40
AGORA_REQUEST_TIMEOUT=180

# Wie viel eigenes Material ein Agent hoechstens tragen darf, in Zeichen
# ueber alle seine Unterlagen zusammen. Das liegt in JEDEM seiner Aufrufe,
# genauso wie die Persona - die Kosten wachsen also mit jeder Runde.
# 12000 Zeichen sind grob 3500 Token.
AGORA_WISSEN_ZEICHEN=12000
